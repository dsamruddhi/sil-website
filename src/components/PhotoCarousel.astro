---
// Swipeable photo carousel. Clicking a photo opens it in the full-screen viewer
// (PhotoLightbox.astro, included once on the page).
export interface CarouselPhoto {
  /** Paths relative to public/ */
  small: string;
  large: string;
  alt: string;
  /** CSS object-position for cropping inside the box */
  position?: string;
  /** Show the whole photo (with plain bands) instead of filling the box */
  contain?: boolean;
}

interface Props {
  photos: CarouselPhoto[];
  /** Name shown in the full-screen viewer and read by screen readers */
  label: string;
  /** Number of placeholder slides when there are no photos */
  placeholders?: number;
  class?: string;
}

const { photos, label, placeholders = 3, class: className } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const count = photos.length || placeholders;
---

<div
  class:list={['photo-carousel group relative aspect-[3/2] overflow-hidden border border-ink/10 bg-ink/5', className]}
  role="region"
  aria-roledescription="carousel"
  aria-label={`${label} photos`}
  tabindex="0"
  data-title={label}
  data-photos={JSON.stringify(photos.map((p) => ({ src: `${base}${p.large}`, alt: p.alt })))}
>
  <div class="carousel-track flex h-full overflow-x-auto snap-x snap-mandatory scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    {photos.length > 0
      ? photos.map((photo, n) => (
          <figure class="relative shrink-0 w-full h-full snap-start" aria-roledescription="slide" aria-label={`${n + 1} of ${count}`}>
            <img
              src={`${base}${photo.small}`}
              alt={photo.alt}
              loading="lazy"
              decoding="async"
              class:list={['absolute inset-0 w-full h-full', photo.contain ? 'object-contain' : 'object-cover']}
              style={photo.position ? `object-position: ${photo.position}` : undefined}
            />
            <button
              type="button"
              class="lightbox-open absolute inset-0 w-full h-full cursor-zoom-in focus-visible:outline focus-visible:outline-2 focus-visible:outline-red focus-visible:-outline-offset-2"
              data-index={n}
              aria-label={`View photo ${n + 1} full screen`}
            ></button>
          </figure>
        ))
      : Array.from({ length: placeholders }, (_, n) => (
          <div
            class="relative shrink-0 w-full h-full snap-start flex flex-col items-center justify-center gap-2 bg-[repeating-linear-gradient(135deg,transparent_0_10px,rgba(24,24,24,0.035)_10px_20px)]"
            aria-roledescription="slide"
            aria-label={`${n + 1} of ${count}`}
          >
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" class="text-ink/25" aria-hidden="true">
              <rect x="3" y="6" width="18" height="14" rx="1.5" />
              <path d="M8 6L9.5 3.5H14.5L16 6" stroke-linejoin="round" />
              <circle cx="12" cy="13" r="3.5" />
            </svg>
            <span class="font-mono text-[10px] uppercase tracking-wider text-ink/30">Photo {n + 1}</span>
          </div>
        ))}
  </div>

  <!-- Counter -->
  <span class="carousel-counter absolute top-2 right-2 bg-beige/90 text-ink font-mono text-[10px] px-2 py-1 pointer-events-none">
    01 / {String(count).padStart(2, '0')}
  </span>

  <!-- Arrows -->
  <button
    type="button"
    class="carousel-prev absolute left-2 top-1/2 -translate-y-1/2 w-8 h-8 bg-beige/90 border border-ink/10 flex items-center justify-center text-ink hover:text-red hover:border-red/40 transition md:opacity-0 md:group-hover:opacity-100 focus-visible:opacity-100 disabled:!opacity-0 disabled:pointer-events-none"
    aria-label="Previous photo"
    disabled
  >
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 2L4 7L9 12" /></svg>
  </button>
  <button
    type="button"
    class="carousel-next absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 bg-beige/90 border border-ink/10 flex items-center justify-center text-ink hover:text-red hover:border-red/40 transition md:opacity-0 md:group-hover:opacity-100 focus-visible:opacity-100 disabled:!opacity-0 disabled:pointer-events-none"
    aria-label="Next photo"
    disabled={count < 2}
  >
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 2L10 7L5 12" /></svg>
  </button>

  <!-- Dots -->
  <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1.5 bg-beige/80 px-2 py-1.5">
    {Array.from({ length: count }, (_, n) => (
      <button
        type="button"
        class:list={['carousel-dot w-1.5 h-1.5 transition-colors', n === 0 ? 'bg-red' : 'bg-ink/25 hover:bg-ink/50']}
        aria-label={`Go to photo ${n + 1}`}
        aria-current={n === 0 ? 'true' : undefined}
      />
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.photo-carousel').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('.carousel-track')!;
    const slides = Array.from(track.children) as HTMLElement[];
    const prev = carousel.querySelector<HTMLButtonElement>('.carousel-prev')!;
    const next = carousel.querySelector<HTMLButtonElement>('.carousel-next')!;
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.carousel-dot'));
    const counter = carousel.querySelector<HTMLElement>('.carousel-counter')!;
    const total = String(slides.length).padStart(2, '0');
    let index = 0;

    const goTo = (i: number) => {
      const target = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: target * track.clientWidth });
      render(target);
    };

    const update = () => render(Math.round(track.scrollLeft / Math.max(1, track.clientWidth)));

    const render = (i: number) => {
      index = i;
      counter.textContent = `${String(index + 1).padStart(2, '0')} / ${total}`;
      prev.disabled = index === 0;
      next.disabled = index >= slides.length - 1;
      dots.forEach((dot, n) => {
        const active = n === index;
        dot.classList.toggle('bg-red', active);
        dot.classList.toggle('bg-ink/25', !active);
        if (active) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    // Sync after swipes / trackpad scrolling, once the scroll settles
    let settle = 0;
    track.addEventListener('scroll', () => {
      clearTimeout(settle);
      settle = window.setTimeout(update, 120);
    });
    prev.addEventListener('click', () => goTo(index - 1));
    next.addEventListener('click', () => goTo(index + 1));
    dots.forEach((dot, n) => dot.addEventListener('click', () => goTo(n)));
    carousel.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(index - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); goTo(index + 1); }
    });
    window.addEventListener('resize', () => goTo(index));
  });
</script>
