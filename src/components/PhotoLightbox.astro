<!-- Full-screen photo viewer, shared by every PhotoCarousel and poster on the page.
     Zoom: click the photo, scroll the mouse wheel, pinch on touch screens, the +/- buttons or keys.
     When zoomed in, drag to move around. -->
<dialog
  id="photo-lightbox"
  class="m-0 p-0 w-screen h-[100dvh] max-w-none max-h-none bg-transparent text-beige backdrop:bg-ink overflow-hidden"
  aria-label="Photo viewer"
>
  <div class="lightbox-stage relative w-full h-full flex flex-col">
    <div class="relative z-10 flex items-center justify-between gap-4 px-4 sm:px-6 py-3 shrink-0 bg-ink">
      <p class="font-mono text-xs uppercase tracking-wider truncate min-w-0">
        <span class="lightbox-title text-beige"></span>
        <span class="lightbox-counter text-beige/50 ml-3"></span>
      </p>
      <div class="flex items-center gap-2 shrink-0">
        <span class="hidden md:inline font-mono text-[10px] uppercase tracking-wider text-beige/40 mr-2">Click or scroll to zoom · drag to move</span>
        <button type="button" class="lightbox-zoom-out w-10 h-10 flex items-center justify-center border border-beige/20 hover:border-beige/60 transition-colors disabled:opacity-30 disabled:pointer-events-none" aria-label="Zoom out">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8H13" /></svg>
        </button>
        <button type="button" class="lightbox-zoom-reset h-10 min-w-[3.5rem] px-2 font-mono text-xs border border-beige/20 hover:border-beige/60 transition-colors" aria-label="Reset zoom">100%</button>
        <button type="button" class="lightbox-zoom-in w-10 h-10 flex items-center justify-center border border-beige/20 hover:border-beige/60 transition-colors disabled:opacity-30 disabled:pointer-events-none" aria-label="Zoom in">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8H13M8 3V13" /></svg>
        </button>
        <button type="button" class="lightbox-close w-10 h-10 ml-2 flex items-center justify-center border border-beige/20 hover:border-beige/60 transition-colors" aria-label="Close viewer">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 3L13 13M13 3L3 13" /></svg>
        </button>
      </div>
    </div>

    <div class="lightbox-backdrop relative flex-1 min-h-0 flex items-center justify-center px-4 sm:px-20 pb-6 overflow-hidden">
      <img class="lightbox-img max-w-full max-h-full object-contain select-none" alt="" draggable="false" />

      <button type="button" class="lightbox-prev absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center bg-ink/60 border border-beige/20 hover:border-beige/60 transition-colors disabled:opacity-0 disabled:pointer-events-none" aria-label="Previous photo">
        <svg width="16" height="16" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 2L4 7L9 12" /></svg>
      </button>
      <button type="button" class="lightbox-next absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center bg-ink/60 border border-beige/20 hover:border-beige/60 transition-colors disabled:opacity-0 disabled:pointer-events-none" aria-label="Next photo">
        <svg width="16" height="16" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 2L10 7L5 12" /></svg>
      </button>
    </div>
  </div>
</dialog>

<style>
  .lightbox-img {
    transform-origin: center center;
    touch-action: none;
    cursor: zoom-in;
    will-change: transform;
  }
  .lightbox-img.is-zoomed { cursor: grab; }
  .lightbox-img.is-dragging { cursor: grabbing; }
  .lightbox-img.is-animating { transition: transform 0.2s ease-out; }
  /* Only one photo in the list: no previous/next buttons */
  .lightbox-prev:disabled + .lightbox-next:disabled { display: none; }
</style>

<script>
  // ---- Full-screen viewer ----
  const dialog = document.getElementById('photo-lightbox') as HTMLDialogElement | null;
  if (dialog) {
    const img = dialog.querySelector<HTMLImageElement>('.lightbox-img')!;
    const area = dialog.querySelector<HTMLElement>('.lightbox-backdrop')!;
    const title = dialog.querySelector<HTMLElement>('.lightbox-title')!;
    const counter = dialog.querySelector<HTMLElement>('.lightbox-counter')!;
    const prev = dialog.querySelector<HTMLButtonElement>('.lightbox-prev')!;
    const next = dialog.querySelector<HTMLButtonElement>('.lightbox-next')!;
    const zoomInBtn = dialog.querySelector<HTMLButtonElement>('.lightbox-zoom-in')!;
    const zoomOutBtn = dialog.querySelector<HTMLButtonElement>('.lightbox-zoom-out')!;
    const zoomResetBtn = dialog.querySelector<HTMLButtonElement>('.lightbox-zoom-reset')!;
    let photos: { src: string; alt: string }[] = [];
    let current = 0;

    // ---- Zoom state: the photo is drawn at `scale` and shifted by (tx, ty) pixels ----
    const MIN = 1;
    const MAX = 6;
    const STEP = 1.5;
    let scale = 1;
    let tx = 0;
    let ty = 0;

    const apply = (animate = false) => {
      img.classList.toggle('is-animating', animate);
      img.style.transform = scale === 1 ? '' : `translate(${tx}px, ${ty}px) scale(${scale})`;
      img.classList.toggle('is-zoomed', scale > 1);
      zoomResetBtn.textContent = `${Math.round(scale * 100)}%`;
      zoomInBtn.disabled = scale >= MAX;
      zoomOutBtn.disabled = scale <= MIN;
    };

    // Keep the zoomed photo covering the viewing area (no empty gaps when it is larger than the area)
    const clamp = () => {
      const view = area.getBoundingClientRect();
      const w = img.offsetWidth * scale;
      const h = img.offsetHeight * scale;
      const limitX = Math.max(0, (w - view.width) / 2);
      const limitY = Math.max(0, (h - view.height) / 2);
      tx = Math.max(-limitX, Math.min(limitX, tx));
      ty = Math.max(-limitY, Math.min(limitY, ty));
    };

    // Zoom to `target`, keeping the screen point (px, py) fixed (defaults to the photo's centre)
    const zoomTo = (target: number, px?: number, py?: number, animate = false) => {
      const s = Math.max(MIN, Math.min(MAX, target));
      const r = img.getBoundingClientRect();
      const cx = r.left + r.width / 2 - tx; // centre of the un-shifted photo
      const cy = r.top + r.height / 2 - ty;
      const x = px ?? cx + tx;
      const y = py ?? cy + ty;
      const k = s / scale;
      tx = x - cx - k * (x - cx - tx);
      ty = y - cy - k * (y - cy - ty);
      scale = s;
      if (scale === 1) { tx = 0; ty = 0; }
      clamp();
      apply(animate);
    };
    const resetZoom = () => { scale = 1; tx = 0; ty = 0; apply(); };

    const show = (i: number) => {
      current = Math.max(0, Math.min(photos.length - 1, i));
      resetZoom();
      img.src = photos[current].src;
      img.alt = photos[current].alt;
      counter.textContent = photos.length > 1 ? `${current + 1} / ${photos.length}` : '';
      prev.disabled = current === 0;
      next.disabled = current === photos.length - 1;
    };

    // Restore page scrolling. Called directly when we close the viewer, and again from
    // the dialog's own events (Esc key), since the 'close' event can arrive late.
    const unlock = () => {
      document.documentElement.style.overflow = '';
      img.removeAttribute('src');
      resetZoom();
    };
    const close = () => {
      dialog.close();
      unlock();
    };

    const open = (list: { src: string; alt: string }[], label: string, index: number) => {
      photos = list;
      title.textContent = label;
      show(index);
      document.documentElement.style.overflow = 'hidden';
      dialog.showModal();
    };

    document.querySelectorAll<HTMLElement>('.photo-carousel').forEach((carousel) => {
      const list = JSON.parse(carousel.dataset.photos || '[]');
      carousel.querySelectorAll<HTMLButtonElement>('.lightbox-open').forEach((btn) => {
        btn.addEventListener('click', () => open(list, carousel.dataset.title || '', Number(btn.dataset.index)));
      });
    });

    // Any other element can open the viewer with data-lightbox-photos (JSON list) and data-lightbox-title
    document.querySelectorAll<HTMLElement>('[data-lightbox-photos]').forEach((el) => {
      const list = JSON.parse(el.dataset.lightboxPhotos || '[]');
      el.addEventListener('click', () => open(list, el.dataset.lightboxTitle || '', 0));
    });

    dialog.addEventListener('cancel', unlock); // Esc key
    dialog.addEventListener('close', unlock);
    prev.addEventListener('click', () => show(current - 1));
    next.addEventListener('click', () => show(current + 1));
    dialog.querySelector('.lightbox-close')!.addEventListener('click', close);
    zoomInBtn.addEventListener('click', () => zoomTo(scale * STEP, undefined, undefined, true));
    zoomOutBtn.addEventListener('click', () => zoomTo(scale / STEP, undefined, undefined, true));
    zoomResetBtn.addEventListener('click', () => zoomTo(1, undefined, undefined, true));

    // ---- Mouse wheel / trackpad zoom, towards the pointer ----
    area.addEventListener('wheel', (e) => {
      if (!img.getAttribute('src')) return;
      e.preventDefault();
      zoomTo(scale * Math.exp(-e.deltaY * 0.0015), e.clientX, e.clientY);
    }, { passive: false });

    // ---- Drag to move, pinch to zoom, click to zoom in/out ----
    const pointers = new Map<number, { x: number; y: number }>();
    let moved = false; // the last press turned into a drag or pinch, so it isn't a click
    let startX = 0;
    let startY = 0;
    let pinchDist = 0;
    let pinchScale = 1;

    const dist = () => {
      const [a, b] = Array.from(pointers.values());
      return Math.hypot(a.x - b.x, a.y - b.y);
    };
    const mid = () => {
      const [a, b] = Array.from(pointers.values());
      return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
    };

    img.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      try { img.setPointerCapture(e.pointerId); } catch { /* keep going without capture */ }
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pointers.size === 1) {
        moved = false;
        startX = e.clientX;
        startY = e.clientY;
      } else if (pointers.size === 2) {
        moved = true;
        pinchDist = dist();
        pinchScale = scale;
      }
      img.classList.remove('is-animating');
    });

    img.addEventListener('pointermove', (e) => {
      const p = pointers.get(e.pointerId);
      if (!p) return;
      const dx = e.clientX - p.x;
      const dy = e.clientY - p.y;
      p.x = e.clientX;
      p.y = e.clientY;

      if (pointers.size >= 2) {
        const m = mid();
        zoomTo(pinchScale * (dist() / pinchDist), m.x, m.y);
        return;
      }
      if (Math.hypot(e.clientX - startX, e.clientY - startY) > 6) moved = true;
      if (scale > 1 && moved) {
        img.classList.add('is-dragging');
        tx += dx;
        ty += dy;
        clamp();
        apply();
      }
    });

    const release = (e: PointerEvent) => {
      if (!pointers.delete(e.pointerId)) return;
      img.classList.remove('is-dragging');
      if (pointers.size === 1) {
        // One finger left after a pinch: carry on dragging from where it is
        const [p] = Array.from(pointers.values());
        startX = p.x;
        startY = p.y;
      }
    };
    img.addEventListener('pointerup', release);
    img.addEventListener('pointercancel', release);

    img.addEventListener('click', (e) => {
      if (moved) return;
      if (scale > 1) zoomTo(1, undefined, undefined, true);
      else zoomTo(2.5, e.clientX, e.clientY, true);
    });

    // Click on the dark area (not the photo or buttons) closes, unless it was the end of a drag
    dialog.addEventListener('click', (e) => {
      if (moved) { moved = false; return; }
      const t = e.target as HTMLElement;
      if (t === dialog || t.classList.contains('lightbox-backdrop') || t.classList.contains('lightbox-stage')) close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(current + 1); }
      if (e.key === '+' || e.key === '=') { e.preventDefault(); zoomTo(scale * STEP, undefined, undefined, true); }
      if (e.key === '-' || e.key === '_') { e.preventDefault(); zoomTo(scale / STEP, undefined, undefined, true); }
      if (e.key === '0') { e.preventDefault(); zoomTo(1, undefined, undefined, true); }
    });

    window.addEventListener('resize', () => { if (dialog.open) { clamp(); apply(); } });

    // Swipe on touch screens to change photo (only when not zoomed in)
    let swipeX = 0;
    let swipeY = 0;
    let multiTouch = false;
    dialog.addEventListener('touchstart', (e) => {
      if (e.touches.length > 1) multiTouch = true;
      else { multiTouch = false; swipeX = e.touches[0].clientX; swipeY = e.touches[0].clientY; }
    }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      if (multiTouch || scale > 1 || e.touches.length > 0) return;
      const dx = e.changedTouches[0].clientX - swipeX;
      const dy = e.changedTouches[0].clientY - swipeY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(current + (dx < 0 ? 1 : -1));
    });
  }
</script>
