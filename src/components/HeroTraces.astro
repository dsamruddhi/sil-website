---
// Decorative PCB artwork behind the home-section logo. Pads sit in a ring around the
// logo like a round connector; from each pad a trace runs straight outward, bends to the
// nearest 0°/45°/90° direction, and runs out to a via or off-screen. Chip/resistor footprints, via fields, mounting
// holes and silkscreen labels fill the outer board, and a few traces carry signal
// pulses flowing into the logo.
//
// Coordinates are logo-centred, with the logo 400 units wide. Hero.astro scales the
// whole SVG with the logo, so the traces always line up with its edges.

const LOGO_W = 400;
const LOGO_H = LOGO_W * 0.6103; // sil-logo.webp is 639 x 390
const HX = LOGO_W / 2;
const HY = LOGO_H / 2;
const FAR = 1500; // "runs off the board"
const VIEW = { x: -1200, y: -700, w: 2400, h: 1400 };

type Pt = [number, number];

// Pad ring: an oval just clear of the logo's corners (a true circle that size would hit
// the nav bar above and the heading below). The arc under the logo is left empty.
const RX = 290;
const RY = 178;
const BEND_AT = 1.3; // traces run radially out to 1.3x the ring, then bend
const STEP = 4.5; // degrees between pads
const ARC_FROM = -205; // degrees; 0 = right, -90 = top (screen y points down)
const ARC_TO = 25;
// Pads come in groups: [pads on, pads skipped, ...]
const GROUPS = [4, 1, 3, 2, 5, 1, 3, 1, 4, 2, 3, 1, 5, 2, 4, 1, 3, 2, 4, 1, 3, 1, 5, 2, 4];
// Per group: null = trace runs off-screen, number = length after the bend before a via
const GROUP_ENDS = [null, 220, null, 140, null, 300, 180, null, 260, null, 120, null, 240];

interface Trace { d: string; len: number; pad: Pt; angle: number; via: Pt | null }

// Footprints the traces must not run through (filled in below, used by routeRing)
const keepOut: { x0: number; y0: number; x1: number; y1: number }[] = [];

function hitsKeepOut([x, y]: Pt) {
  return keepOut.some((b) => x > b.x0 && x < b.x1 && y > b.y0 && y < b.y1);
}

function routeRing(): Trace[] {
  const out: Trace[] = [];
  let a = ARC_FROM;
  let g = 0;
  while (a <= ARC_TO) {
    const on = GROUPS[g % GROUPS.length];
    const skip = GROUPS[(g + 1) % GROUPS.length];
    const endLen = GROUP_ENDS[(g / 2) % GROUP_ENDS.length];
    for (let n = 0; n < on && a <= ARC_TO; n++, a += STEP) {
      const t = (a * Math.PI) / 180;
      const pad: Pt = [RX * Math.cos(t), RY * Math.sin(t)];
      const radial = Math.atan2(pad[1], pad[0]);
      const bend: Pt = [pad[0] * BEND_AT, pad[1] * BEND_AT];
      const phi = (Math.round((radial * 180) / Math.PI / 45) * 45 * Math.PI) / 180;
      const dir: Pt = [Math.cos(phi), Math.sin(phi)];

      // Run outward; stop early (with a via) before any footprint in the way
      const maxLen = endLen === null ? FAR : endLen + (n % 2) * 14;
      let L = 0;
      let blocked = false;
      for (; L < maxLen; L += 6) {
        if (hitsKeepOut([bend[0] + dir[0] * (L + 14), bend[1] + dir[1] * (L + 14)])) { blocked = true; break; }
      }
      const end: Pt = [bend[0] + dir[0] * L, bend[1] + dir[1] * L];
      const pts = [pad, bend, end];
      const len = Math.hypot(bend[0] - pad[0], bend[1] - pad[1]) + L;
      out.push({
        d: 'M' + pts.map((p) => p.map((v) => +v.toFixed(1)).join(' ')).join('L'),
        len: Math.round(len),
        pad,
        angle: (radial * 180) / Math.PI,
        via: endLen === null && !blocked ? null : end,
      });
    }
    a += skip * STEP;
    g += 2;
  }
  return out;
}

// Board furniture -----------------------------------------------------------
const ics = [
  { x: -580, y: -170, w: 72, h: 46, pins: 4, label: 'U2' },
  { x: 600, y: 10, w: 92, h: 52, pins: 5, label: 'U7' },
  { x: -900, y: 120, w: 60, h: 60, pins: 4, label: 'U4' },
  { x: 900, y: -280, w: 64, h: 40, pins: 3, label: 'U9' },
  { x: -300, y: -470, w: 56, h: 36, pins: 3, label: 'U1' },
  { x: 330, y: -480, w: 70, h: 40, pins: 4, label: 'U5' },
];
const passives = [
  { x: -460, y: 250, label: 'R12', rot: 0 },
  { x: 500, y: -210, label: 'C4', rot: 90 },
  { x: -780, y: -390, label: 'R3', rot: 0 },
  { x: 800, y: 370, label: 'C11', rot: 0 },
  { x: -1010, y: -90, label: 'R8', rot: 90 },
  { x: 1030, y: 130, label: 'R21', rot: 90 },
  { x: -660, y: 420, label: 'C2', rot: 0 },
  { x: 700, y: -420, label: 'R15', rot: 0 },
];
const viaFields: Pt[] = [[-430, -320], [430, 300], [-990, 330], [990, -440], [-180, -560], [200, -590]];
const holes: Pt[] = [[-1120, -620], [1120, -620], [-1120, 620], [1120, 620]];
for (const c of ics) keepOut.push({ x0: c.x - c.w / 2 - 20, y0: c.y - c.h / 2 - 12, x1: c.x + c.w / 2 + 20, y1: c.y + c.h / 2 + 28 });
for (const p of passives) keepOut.push({ x0: p.x - 28, y0: p.y - 28, x1: p.x + 28, y1: p.y + 28 });
for (const [x, y] of viaFields) keepOut.push({ x0: x - 12, y0: y - 12, x1: x + 44, y1: y + 44 });

const traces = routeRing();

// Signal pulses on every few traces: flow from the outer end into the logo
const pulses = traces
  .map((t, i) => ({ t, i }))
  .filter(({ i }) => i % 7 === 3)
  .map(({ t, i }, n) => ({ d: t.d, len: t.len, dur: 4.5 + (n % 4) * 0.7, delay: (n * 1.3) % 6 }));

const silk = [
  { x: -1080, y: 575, text: 'SIL · EE@IITD' },
  { x: 1080, y: 575, text: 'REV 2.6 · STUDENT INNOVATION LAB', anchor: 'end' },
  { x: -1080, y: -560, text: 'J1  PWR 5V' },
  { x: 1080, y: -560, text: 'J2  I²C · SPI · UART', anchor: 'end' },
];
---

<svg
  class="hero-traces pointer-events-none select-none"
  viewBox={`${VIEW.x} ${VIEW.y} ${VIEW.w} ${VIEW.h}`}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <radialGradient id="ht-fade" cx="0" cy="0" r="1250" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#fff" />
      <stop offset="0.4" stop-color="#fff" />
      <stop offset="1" stop-color="#333" />
    </radialGradient>
    <filter id="ht-soft" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="28" />
    </filter>
    <mask id="ht-mask" maskUnits="userSpaceOnUse" x={VIEW.x} y={VIEW.y} width={VIEW.w} height={VIEW.h}>
      <rect x={VIEW.x} y={VIEW.y} width={VIEW.w} height={VIEW.h} fill="url(#ht-fade)" />
      <!-- Keep the heading, text and buttons under the logo clear -->
      <rect x="-440" y={HY + 14} width="880" height="460" rx="80" fill="#000" filter="url(#ht-soft)" />
    </mask>
  </defs>

  <g mask="url(#ht-mask)">
    <!-- Board furniture -->
    <g class="ht-ink">
      {holes.map(([x, y]) => (
        <g>
          <circle cx={x} cy={y} r="20" fill="none" stroke-width="5" />
          <circle cx={x} cy={y} r="9" fill="none" stroke-width="1.5" />
        </g>
      ))}
      {ics.map((c) => {
        const step = c.h / (c.pins + 1);
        return (
          <g>
            <rect x={c.x - c.w / 2} y={c.y - c.h / 2} width={c.w} height={c.h} rx="3" fill="none" stroke-width="1.5" />
            <circle cx={c.x - c.w / 2 + 8} cy={c.y - c.h / 2 + 8} r="2.5" class="ht-ink-fill" />
            {Array.from({ length: c.pins }, (_, n) => (
              <>
                <rect x={c.x - c.w / 2 - 12} y={c.y - c.h / 2 + step * (n + 1) - 3} width="10" height="6" class="ht-pad" />
                <rect x={c.x + c.w / 2 + 2} y={c.y - c.h / 2 + step * (n + 1) - 3} width="10" height="6" class="ht-pad" />
              </>
            ))}
            <text x={c.x} y={c.y + c.h / 2 + 18} text-anchor="middle" class="ht-silk">{c.label}</text>
          </g>
        );
      })}
      {passives.map((p) => (
        <g transform={`translate(${p.x} ${p.y}) rotate(${p.rot})`}>
          <rect x="-15" y="-6" width="10" height="12" class="ht-pad" />
          <rect x="5" y="-6" width="10" height="12" class="ht-pad" />
          <rect x="-20" y="-10" width="40" height="20" rx="2" fill="none" stroke-width="1" />
          <text x="0" y="-16" text-anchor="middle" class="ht-silk" transform={`rotate(${-p.rot})`}>{p.label}</text>
        </g>
      ))}
      {viaFields.map(([x, y]) =>
        [0, 1, 2].flatMap((r) => [0, 1, 2].map((c) => <circle cx={x + c * 16} cy={y + r * 16} r="4" class="ht-via" />)),
      )}
      {silk.map((s) => (
        <text x={s.x} y={s.y} text-anchor={s.anchor ?? 'start'} class="ht-silk ht-silk-lg">{s.text}</text>
      ))}
    </g>

    <!-- Connector ring around the logo -->
    <g class="ht-ink" fill="none">
      <ellipse cx="0" cy="0" rx={RX} ry={RY} stroke-width="1.5" />
      <ellipse cx="0" cy="0" rx={RX - 16} ry={RY - 12} stroke-width="1" stroke-dasharray="2 7" />
    </g>

    <!-- Traces out of the logo -->
    <g class="ht-trace">
      {traces.map((t) => <path d={t.d} />)}
    </g>
    <g>
      {traces.map((t) => (
        <rect x="-7" y="-3.5" width="14" height="7" rx="1" class="ht-pad" transform={`translate(${t.pad[0].toFixed(1)} ${t.pad[1].toFixed(1)}) rotate(${t.angle.toFixed(1)})`} />
      ))}
      {traces.filter((t) => t.via).map((t) => <circle cx={t.via![0]} cy={t.via![1]} r="4.5" class="ht-via" />)}
    </g>

    <!-- Signal pulses flowing into the logo -->
    <g class="ht-pulses">
      {pulses.map((p) => (
        <path
          d={p.d}
          class="ht-pulse"
          style={`--len:${p.len};stroke-dasharray:18 ${p.len + 40};animation-duration:${p.dur}s;animation-delay:${p.delay}s`}
        />
      ))}
    </g>
  </g>
</svg>

<style>
  .hero-traces {
    display: block;
    width: 100%;
    height: auto;
    --trace: #6b0624;
    --ink: #181818;
  }
  .ht-trace path {
    fill: none;
    stroke: var(--trace);
    stroke-opacity: 0.24;
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .ht-pad {
    fill: var(--trace);
    fill-opacity: 0.38;
  }
  .ht-via {
    fill: #f3ebdd;
    stroke: var(--trace);
    stroke-opacity: 0.43;
    stroke-width: 1.8;
  }
  .ht-ink {
    stroke: var(--ink);
    stroke-opacity: 0.2;
  }
  .ht-ink .ht-pad {
    stroke: none;
  }
  .ht-ink-fill {
    fill: var(--ink);
    fill-opacity: 0.28;
    stroke: none;
  }
  .ht-silk {
    fill: var(--ink);
    fill-opacity: 0.3;
    stroke: none;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .ht-silk-lg {
    font-size: 13px;
  }
  .ht-pulse {
    fill: none;
    stroke: var(--trace);
    stroke-opacity: 0.85;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dashoffset: calc(var(--len) * -1);
    animation-name: ht-flow;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  @keyframes ht-flow {
    from { stroke-dashoffset: calc(var(--len) * -1); }
    to { stroke-dashoffset: 18; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ht-pulses { display: none; }
  }
</style>
