---
import { navLinks as links } from '../data/nav';
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 bg-beige/90 backdrop-blur-md border-b border-subtle">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16" aria-label="Main navigation">
    <a href="#home" class="font-mono font-semibold text-sm tracking-[0.15em] uppercase text-ink hover:text-red transition-colors">
      <span class="text-red">S</span>IL
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-1" role="list">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="nav-link px-3 py-2 text-xs font-medium uppercase tracking-[0.1em] text-ink/60 hover:text-red transition-colors relative"
            data-section={link.href.slice(1)}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden flex flex-col gap-[5px] w-8 h-8 items-center justify-center"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open navigation menu"
    >
      <span class="menu-line block w-5 h-[1.5px] bg-ink transition-all duration-300 origin-center"></span>
      <span class="menu-line block w-5 h-[1.5px] bg-ink transition-all duration-300 origin-center"></span>
      <span class="menu-line block w-3 h-[1.5px] bg-ink transition-all duration-300 origin-center ml-auto"></span>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden overflow-hidden max-h-0 transition-[max-height] duration-300 ease-in-out bg-beige border-t border-subtle"
    aria-hidden="true"
  >
    <ul class="px-4 py-4 space-y-1" role="list">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="mobile-nav-link block px-4 py-3 text-sm font-medium uppercase tracking-[0.1em] text-ink/60 hover:text-red hover:bg-ink/5 transition-colors rounded"
            data-section={link.href.slice(1)}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  .nav-link.active {
    color: #6B0624;
  }
  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #6B0624;
  }
  .mobile-nav-link.active {
    color: #6B0624;
    background: rgba(217, 54, 50, 0.05);
  }
  [aria-expanded="true"] .menu-line:nth-child(1) {
    transform: translateY(3.25px) rotate(45deg);
  }
  [aria-expanded="true"] .menu-line:nth-child(2) {
    opacity: 0;
  }
  [aria-expanded="true"] .menu-line:nth-child(3) {
    width: 1.25rem;
    transform: translateY(-3.25px) rotate(-45deg);
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const mobileLinks = menu.querySelectorAll('.mobile-nav-link');

  function closeMobileMenu() {
    btn.setAttribute('aria-expanded', 'false');
    btn.setAttribute('aria-label', 'Open navigation menu');
    menu.style.maxHeight = '0';
    menu.setAttribute('aria-hidden', 'true');
  }

  function openMobileMenu() {
    btn.setAttribute('aria-expanded', 'true');
    btn.setAttribute('aria-label', 'Close navigation menu');
    menu.style.maxHeight = menu.scrollHeight + 'px';
    menu.setAttribute('aria-hidden', 'false');
    const firstLink = menu.querySelector<HTMLAnchorElement>('.mobile-nav-link');
    firstLink?.focus();
  }

  btn.addEventListener('click', () => {
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    if (isOpen) closeMobileMenu();
    else openMobileMenu();
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', closeMobileMenu);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
      closeMobileMenu();
      btn.focus();
    }
  });

  // Active section tracking
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.nav-link, .mobile-nav-link');

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          navLinks.forEach((link) => {
            const linkSection = link.getAttribute('data-section');
            link.classList.toggle('active', linkSection === id);
          });
        }
      });
    },
    { threshold: 0.2, rootMargin: '-80px 0px -40% 0px' }
  );

  sections.forEach((section) => sectionObserver.observe(section));
</script>
